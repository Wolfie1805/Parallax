# ── Frontend Production Environment Variables ─────────────────────────────────
# Copy this file to .env.production.local and fill in your values.
# Or set these directly in Vercel Project Settings → Environment Variables.
#
# REQUIRED if frontend and backend are separate Vercel projects:
#   Set VITE_API_BASE_URL to the URL of your backend Vercel deployment, e.g.:
#   https://parallax-backend.vercel.app
#
# If deploying as a single Vercel project (recommended), leave this EMPTY
# so the frontend uses relative /api/* paths routed to the Python function.

VITE_API_BASE_URL=

# OPTIONAL: Override WebSocket URL directly (derived from VITE_API_BASE_URL if not set)
# VITE_WS_URL=wss://parallax-backend.vercel.app/ws
