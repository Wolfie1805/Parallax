# ── Backend Environment Variables ─────────────────────────────────────────────
# Set these in Vercel Project Settings → Environment Variables (Production).
# Never commit real values to git.

# Database — use PostgreSQL for full persistence on Vercel.
# Vercel Postgres, Neon, Supabase, or Railway all work.
# If not set, defaults to sqlite:////tmp/parallax.db (ephemeral, clears on cold start).
DATABASE_URL=postgresql://user:password@host:5432/parallax

# OpenSky Network OAuth2 credentials (for aircraft data)
OPENSKY_CLIENT_ID=your-client-id
OPENSKY_CLIENT_SECRET=your-client-secret

# CORS: comma-separated list of allowed frontend origins.
# Set this to your Vercel frontend URL.
# Example: https://parallax.vercel.app,https://www.yourdomain.com
CORS_ORIGINS=https://your-frontend.vercel.app
